<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#1c1917">
  <title>Access denied - MGM Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>*{-webkit-tap-highlight-color:rgba(245,158,11,.28)}html{-webkit-text-size-adjust:100%}</style>
</head>
<body class="min-h-screen bg-stone-950 text-stone-100 flex items-center justify-center p-4 antialiased" style="padding:calc(1rem + env(safe-area-inset-top)) calc(1rem + env(safe-area-inset-right)) calc(1rem + env(safe-area-inset-bottom)) calc(1rem + env(safe-area-inset-left))">
  <div class="w-full max-w-md rounded-xl border border-stone-800 bg-stone-900 p-6 sm:p-8">
    <h1 class="text-xl font-semibold mb-3">Access denied</h1>
    <p class="text-[15px] leading-relaxed text-stone-300 mb-6"><%= message %></p>
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
      <a href="https://discord.gg/rush1095" class="w-full rounded-xl bg-amber-500 px-4 py-3.5 text-center text-sm font-bold text-stone-950 active:bg-amber-400 sm:w-auto hover:bg-amber-400">Join the Discord server</a>
      <a href="/" class="w-full rounded-xl border border-stone-700 bg-stone-800 px-4 py-3 text-center text-sm font-medium active:bg-stone-700 sm:w-auto hover:bg-stone-700">Back</a>
    </div>
  </div>
</body>
</html>
